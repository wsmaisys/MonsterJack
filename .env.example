# Monster Jack Environment Configuration

# Application
ENVIRONMENT=development
SECRET_KEY=monsterjack-super-secret-jwt-token-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite+aiosqlite:///./monster_jack.db
# For PostgreSQL in Docker:
# DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/monster_jack

# Redis (Task Queue & Cache)
REDIS_URL=redis://localhost:6379/0

# AI Configuration
# Default LLM Provider: ollama | openai | gemini
AI_PROVIDER=ollama

# Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Google Gemini / Imagen (Image Generation)
GEMINI_API_KEY=
IMAGEN_MODEL=imagen-3.0-generate-002

# OpenAI Settings (Optional fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Social Media OAuth (Placeholders for V1)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/callback/linkedin

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://localhost:3000/api/auth/callback/twitter

# Email Service (Resend or SMTP)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@monsterjack.io
